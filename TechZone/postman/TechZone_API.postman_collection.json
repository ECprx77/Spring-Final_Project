							"mode": "raw",
							"raw": "{\n  \"email\": \"postman.admin@techzone-test.com\",\n  \"password\": \"PostmanAdmin123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
